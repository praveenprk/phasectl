#!/bin/sh
# install — point git at this hooks directory (core.hooksPath).
# Run once per clone: hooks/install
# Substrate: POSIX sh, git. Exit: 0 installed, non-zero on failure. Quiet on success.

set -eu

dir=$(cd "$(dirname "$0")" && pwd -P)
root=$(cd "$dir" && git rev-parse --show-toplevel)
root=$(cd "$root" && pwd -P)

git -C "$root" config core.hooksPath "${dir#"$root"/}"
